   "fieldtype": "Section Break",
   "label": "Access"
  },
  {
   "default": "0",
   "description": "Let anyone open /reading and read the published books without an account. Guests' readers and progress are kept in their own browser only, and they get the standard feedback rather than Claude's. Signed-in families are unaffected.",
   "fieldname": "allow_guests",
   "fieldtype": "Check",
   "label": "Sign-up not required"
  },
  {
   "fieldname": "ai_section",
   "fieldtype": "Section Break",
   "label": "Claude"
  },
  {
   "default": "1",
